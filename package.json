{
	"name": "publication-agent",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "flue dev --target cloudflare",
		"build": "flue build --target cloudflare",
		"deploy": "flue build --target cloudflare && wrangler deploy --config dist/publication_agent/wrangler.json",
		"deploy:dry-run": "flue build --target cloudflare && wrangler deploy --dry-run --config dist/publication_agent/wrangler.json",
		"typecheck": "tsc --noEmit && tsc --noEmit -p workers/research-control-plane",
		"test": "vitest run",
		"test:research": "vitest run tests/research",
		"check": "npm run typecheck && npm run test && npm run build",
		"scan": "node --env-file-if-exists=.dev.vars scripts/run-research-scan.mjs scan",
		"audit:watch": "node --env-file-if-exists=.dev.vars scripts/research-audit.mjs watch",
		"audit:export": "node --env-file-if-exists=.dev.vars scripts/research-audit.mjs export",
		"eval:research-provider": "node --env-file-if-exists=.dev.vars scripts/benchmark-research-provider.mjs",
		"eval:research": "node --experimental-strip-types scripts/research-eval.mjs run",
		"eval:research:offline": "node --experimental-strip-types scripts/research-eval.mjs run --suite evals/research/cases/suite.json",
		"eval:research:compare": "node --experimental-strip-types scripts/research-eval.mjs compare",
		"eval:research:canary": "node --env-file-if-exists=.dev.vars scripts/research-canary.mjs",
		"control-plane:dev": "wrangler dev --config workers/research-control-plane/wrangler.jsonc --env local --env-file .dev.vars",
		"control-plane:deploy:dry-run": "wrangler deploy --dry-run --config workers/research-control-plane/wrangler.jsonc --env=\"\"",
		"control-plane:deploy": "wrangler deploy --config workers/research-control-plane/wrangler.jsonc --env=\"\"",
	},
	"dependencies": {
		"@earendil-works/pi-ai": "0.80.10",
		"@flue/runtime": "^1.0.0-beta.9",
		"@flue/sdk": "^1.0.0-beta.9",
		"agents": "^0.14.5",
		"valibot": "^1.4.2"
	},
	"devDependencies": {
		"@cloudflare/workers-types": "^5.20260721.1",
		"@flue/cli": "^1.0.0-beta.9",
		"typescript": "^5.9.3",
		"vitest": "^4.1.10",
		"wrangler": "^4.113.0"
	}
}
